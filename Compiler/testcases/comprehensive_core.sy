// Expected: should compile and generate Koopa IR
// Expected return value: 71

const int N = 5;
const int LIMIT = 4;
int g_bias = 7;
int g_arr[5] = {1, 2, 3, 4, 5};
int g_mat[2][3] = {{1, 2, 3}, {4, 5, 6}};

int add(int a, int b) {
  return a + b;
}

int sum_array(int a[], int n) {
  int i = 0;
  int sum = 0;
  while (i < n) {
    int v = a[i];
    i = i + 1;
    if (v == 0) {
      continue;
    }
    if (v > 20) {
      break;
    }
    sum = sum + v;
  }
  return sum;
}

int get_2d(int a[][3], int i, int j) {
  return a[i][j];
}

int complex_calc(int x) {
  int i = 0;
  int acc = 0;
  while (i < 6) {
    i = i + 1;
    if (i == 2) {
      continue;
    }
    if (i > LIMIT) {
      break;
    }
    if ((x > 0 && i < 4) || x == 0) {
      acc = acc + add(x, i);
    } else {
      acc = acc - i;
    }
  }
  return acc;
}

int main() {
  int local[5] = {5, 4, 3, 2, 1};
  int mat[2][3] = {{2, 4, 6}, {1, 3, 5}};
  int total = 0;
  total = total + sum_array(g_arr, N);
  total = total + sum_array(local, N);
  total = total + get_2d(g_mat, 1, 2);
  total = total + get_2d(mat, 0, 1);
  total = total + complex_calc(3);

  int i = 0;
  while (i < N) {
    i = i + 1;
    if (i == 2) {
      continue;
    }
    if (i == 5) {
      break;
    }
    total = total + i;
  }

  if (total > 0 && g_bias > 0) {
    total = add(total, g_bias);
  } else {
    total = total - 100;
  }

  if (0 || total == 61) {
    total = total + 1;
  }

  {
    int total = 9;
    {
      int total = local[0] + local[1];
      g_arr[0] = total;
    }
  }

  total = total + g_arr[0];
  return total;
}
